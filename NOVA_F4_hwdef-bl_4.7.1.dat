# Zerodrag NOVA F4 bootloader hardware definition
# NOVA uses the ArduPilot MatekF405-TE board ID (1054).

MCU STM32F4xx STM32F405xx
OSCILLATOR_HZ 8000000
APJ_BOARD_ID AP_HW_MatekF405_TE

# Bootloader occupies the first 64 KB; application begins at 64 KB.
FLASH_RESERVE_START_KB 0
FLASH_SIZE_KB 1024
FLASH_BOOTLOADER_LOAD_KB 64

# LEDs used by the bootloader
PA14 LED_BOOTLOADER OUTPUT LOW GPIO(0)
PA13 LED_ACTIVITY OUTPUT LOW GPIO(1)
define HAL_LED_ON 0

# USB + UART1 bootloader access
SERIAL_ORDER OTG1 USART1
PA9 USART1_TX USART1
PA10 USART1_RX USART1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# Keep all SPI chip selects inactive/high during bootloader startup.
PC14 IMU_CS CS
PB12 OSD_CS CS
PC13 FLASH_CS CS
PC1 SDCARD_CS CS

# Match NOVA switched outputs to their normal safe state.
PA4 PINIO1 OUTPUT LOW
PB5 PINIO2 OUTPUT LOW
